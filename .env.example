# CRYPTO PULSE AI — configuration template
#
# Copy to .env and edit. NEVER commit .env — it is gitignored.
# Every value below is optional; the defaults in cryptopulse/config/settings.py
# are what runs if you set nothing.

# ---------------------------------------------------------------- application
CP_ENVIRONMENT=dev
CP_LOG_LEVEL=INFO
CP_LOG_JSON=false

# Hard safety switch. V1 never places an order. Leave this true.
CP_PAPER_MODE=true

CP_API_HOST=0.0.0.0
CP_API_PORT=8000
CP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------ providers
# binance  = Binance Spot public REST (no API key needed for market data)
# kraken   = Kraken public REST. Reachable where Binance is geo-blocked (US).
# fixture  = SYNTHETIC generated candles for offline development. NOT market data.
CP_PROVIDER_MARKET_DATA=binance

CP_PROVIDER_BINANCE_BASE_URL=https://api.binance.com
# Market-data mirror, used automatically if the main host fails.
CP_PROVIDER_BINANCE_FALLBACK_BASE_URL=https://data-api.binance.vision
CP_PROVIDER_KRAKEN_BASE_URL=https://api.kraken.com

# Valuation (market cap) source. OFF by default.
#   none      = no market cap. The ×10 layer reports capacity as UNKNOWN and
#               renormalises around it — it never guesses a cap from price.
#   coingecko = public /coins/markets ranking. NOT LIVE VERIFIED.
# Without this, the single most important input to "can this actually do ×10?"
# is missing, so turn it on if you can reach the host.
CP_PROVIDER_VALUATION=none
CP_PROVIDER_COINGECKO_BASE_URL=https://api.coingecko.com
# CP_PROVIDER_COINGECKO_API_KEY=
# Pages of 250 ranked by market cap. 2 = the top 500, which also makes
# "not in the ranking" a usable upper bound on an asset's cap.
CP_PROVIDER_VALUATION_PAGES=2
CP_PROVIDER_VALUATION_TTL_SECONDS=3600

# API keys are NOT required for the V1 scanner — it reads only public market
# data. Only set these if you later add an authenticated module, and never
# commit them. If a key has ever been committed to git, rotate it: git history
# keeps it forever even after the file is deleted.
# CP_PROVIDER_BINANCE_API_KEY=
# CP_PROVIDER_BINANCE_API_SECRET=

# Request-weight budget per minute. Binance documents ~6000/min per IP for spot
# REST; the default below is a deliberately conservative fraction of that.
CP_PROVIDER_REQUEST_WEIGHT_PER_MINUTE=2400
CP_PROVIDER_MAX_CONCURRENT_REQUESTS=8
CP_PROVIDER_REQUEST_TIMEOUT_SECONDS=15
CP_PROVIDER_MAX_RETRIES=3
CP_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
CP_PROVIDER_CIRCUIT_RESET_SECONDS=60

# -------------------------------------------------------------------- scanner
CP_SCAN_QUOTE_ASSET=USDT
CP_SCAN_MAX_SYMBOLS=120
CP_SCAN_SCAN_INTERVAL_SECONDS=60

# Which assets a scan may look at.
#   volume    = the venue's most liquid pairs (the V1 behaviour)
#   robinhood = only assets believed tradable on Robinhood Crypto. A signal on
#               something you cannot buy is noise, so this is what the radar
#               ships with. The listing is hand-maintained and NOT verified
#               against Robinhood — run `cryptopulse universe` to see exactly
#               what it resolves to on your venue.
CP_SCAN_UNIVERSE=robinhood
# Maintain the listing yourself (JSON: {"as_of": "...", "bases": ["BTC", ...]}).
# `cryptopulse universe --refresh` writes a file in this shape.
# CP_SCAN_ROBINHOOD_FILE=data/robinhood_universe.json
# CP_SCAN_ROBINHOOD_EXTRA=
# CP_SCAN_ROBINHOOD_EXCLUDE=

# How the table is ordered: setup (V1), moonshot (×10 reading first), or blend.
CP_SCAN_RANK_MODE=blend

# Benchmark for the market regime and relative strength. Empty = ask the
# provider for a symbol it is certain to carry (XBTUSDT on Kraken, not BTCUSDT).
CP_SCAN_BENCHMARK_SYMBOL=

# Universe pre-filter, applied before any per-symbol request is spent.
CP_SCAN_MIN_QUOTE_VOLUME_24H=3000000
CP_SCAN_ALWAYS_INCLUDE=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
CP_SCAN_EXCLUDE_PATTERNS=UP,DOWN,BULL,BEAR
CP_SCAN_EXCLUDE_STABLE_BASES=USDC,FDUSD,TUSD,DAI,BUSD,EUR,USDP,USD1

CP_SCAN_PRIMARY_TIMEFRAME=5m
CP_SCAN_TIMEFRAMES=5m,15m,1h,4h
CP_SCAN_CANDLES_PER_TIMEFRAME=300
CP_SCAN_MIN_CANDLES_REQUIRED=60
CP_SCAN_STALE_AFTER_SECONDS=300

# -------------------------------------------------------------------- scoring
# Component weights MUST sum to 100 or the engine refuses to start.
# Changing any of these changes the weights fingerprint recorded with every
# signal, so historical scores are never silently reinterpreted.
CP_SCORE_ENGINE_VERSION=SCORE_ENGINE_V1
CP_SCORE_W_VOLUME=20
CP_SCORE_W_MOMENTUM=15
CP_SCORE_W_STRUCTURE=15
CP_SCORE_W_BREAKOUT=15
CP_SCORE_W_VOLATILITY=10
CP_SCORE_W_ORDERFLOW=10
CP_SCORE_W_MTF=10
CP_SCORE_W_LIQUIDITY=5

CP_SCORE_THRESHOLD_OBSERVE=35
CP_SCORE_THRESHOLD_WATCH=50
CP_SCORE_THRESHOLD_ARMED=65
CP_SCORE_PUMP_MATURITY_LATE=70
CP_SCORE_BREAKOUT_CONFIRM_ATR=0.15
CP_SCORE_ARMED_MAX_DISTANCE_ATR=1.0

# ------------------------------------------------------------------- moonshot
# The ×10 layer. Every number here is a HYPOTHESIS: nothing has been fitted, and
# no ×10 outcome has ever been graded against it. See cryptopulse/scoring/moonshot.py.
CP_MOON_ENABLED=true

# The reading is taken on the daily and refuses to run below 4h — a multi-month
# base is invisible on an intraday chart. This costs one extra kline request per
# asset per scan; set CP_MOON_ENABLED=false if the rate-limit budget is tight.
CP_MOON_TIMEFRAME=1d
CP_MOON_CANDLES=400
CP_MOON_MIN_BARS=80

# The multiple being hunted. Everything scales off it, so ×5 or ×20 re-tunes the
# whole layer coherently rather than just renaming it.
CP_MOON_TARGET_MULTIPLE=10

# Composite weights, renormalised over whatever is available (a missing market
# cap redistributes rather than scoring zero).
CP_MOON_W_IGNITION=55
CP_MOON_W_HEADROOM=20
CP_MOON_W_CAPACITY=25

# Ends of the capacity scale in USD. At 20M a ×10 implies 200M, which happens
# somewhere most weeks; at 20B it implies 200B, which almost nothing has reached.
CP_MOON_CAP_FULL_CAPACITY_USD=20000000
CP_MOON_CAP_NO_CAPACITY_USD=20000000000

CP_MOON_IGNITION_THRESHOLD=60
CP_MOON_EXHAUSTION_MATURITY=70
CP_MOON_MIN_BASE_BARS=20
# Caps applied once the move is no longer early. A late entry still scoring 90
# is the most expensive thing a radar can show you.
CP_MOON_EXPANSION_SCORE_CAP=70
CP_MOON_EXHAUSTION_SCORE_CAP=45

# ----------------------------------------------------------------------- risk
CP_RISK_LIQ_EXCELLENT_VOLUME=100000000
CP_RISK_LIQ_GOOD_VOLUME=20000000
CP_RISK_LIQ_ACCEPTABLE_VOLUME=3000000
CP_RISK_LIQ_POOR_VOLUME=500000
CP_RISK_SPREAD_DANGEROUS_BPS=120
CP_RISK_MAX_RISK_PENALTY=45

# --------------------------------------------------------------------- alerts
CP_ALERT_ENABLED=true
CP_ALERT_MIN_SCORE_INFO=50
CP_ALERT_MIN_SCORE_WATCH=60
CP_ALERT_MIN_SCORE_HIGH=72
CP_ALERT_MIN_SCORE_CRITICAL=82
CP_ALERT_COOLDOWN_SECONDS=1800
CP_ALERT_MAX_ALERTS_PER_SCAN=12

# Moonshot alerts run on their own clock: a daily base does not change between
# two one-minute scans, so re-firing it every scan would train you to ignore it.
CP_ALERT_MIN_SCORE_MOONSHOT=68
CP_ALERT_MOONSHOT_COOLDOWN_SECONDS=21600

# Delivery. An alert nobody sees is not an alert — this is what makes
# `cryptopulse radar` autonomous rather than something you sit and watch.
# Any of: console, jsonl, webhook, telegram, discord.
CP_ALERT_CHANNELS=console,jsonl
CP_ALERT_JSONL_PATH=data/alerts.jsonl
# Generic JSON POST (Slack-compatible endpoints, n8n, your own service).
# CP_ALERT_WEBHOOK_URL=
# Telegram is the channel that actually reaches a phone. Talk to @BotFather for
# a token, and @userinfobot for your chat id. NEVER commit these.
# CP_ALERT_TELEGRAM_BOT_TOKEN=
# CP_ALERT_TELEGRAM_CHAT_ID=
# CP_ALERT_DISCORD_WEBHOOK_URL=
CP_ALERT_DELIVERY_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------- database
# SQLite is for local development only. Use PostgreSQL in production.
CP_DB_URL=sqlite:///data/cryptopulse.db
# CP_DB_URL=postgresql+psycopg://user:password@localhost:5432/cryptopulse
CP_DB_ECHO=false
CP_DB_RETENTION_DAYS=90
