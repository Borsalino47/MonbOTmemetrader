# CRYPTO PULSE AI — configuration template
#
# Copy to .env and edit. NEVER commit .env — it is gitignored.
# Every value below is optional; the defaults in cryptopulse/config/settings.py
# are what runs if you set nothing.

# ---------------------------------------------------------------- application
CP_ENVIRONMENT=dev
CP_LOG_LEVEL=INFO
CP_LOG_JSON=false

# Hard safety switch. V1 never places an order. Leave this true.
CP_PAPER_MODE=true

CP_API_HOST=0.0.0.0
CP_API_PORT=8000
CP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------ providers
# binance  = Binance Spot public REST (no API key needed for market data)
# kraken   = Kraken public REST. Reachable where Binance is geo-blocked (US).
# fixture  = SYNTHETIC generated candles for offline development. NOT market data.
CP_PROVIDER_MARKET_DATA=binance

CP_PROVIDER_BINANCE_BASE_URL=https://api.binance.com
# Market-data mirror, used automatically if the main host fails.
CP_PROVIDER_BINANCE_FALLBACK_BASE_URL=https://data-api.binance.vision
CP_PROVIDER_KRAKEN_BASE_URL=https://api.kraken.com

# There is no API-key setting, on purpose. The scanner reads only public
# market-data endpoints, which need no account. A key field would accept a
# credential nothing could use, while inviting a secret into a file that might
# get committed. If you have CP_PROVIDER_BINANCE_API_KEY left over in a .env
# from an earlier version, it is ignored — and if that key was ever committed
# to git, revoke it: history keeps it forever even after the file is deleted.

# Request-weight budget per minute. Binance documents ~6000/min per IP for spot
# REST; the default below is a deliberately conservative fraction of that.
# Closed candles never change, so caching them costs no freshness at all.
# Measured: 88.8 % of kline requests removed over a 20-scan loop. This is what
# makes a wide token search possible at all, and it saves battery and mobile
# data. The still-forming candle is never cached, and `doctor` always bypasses
# the cache so a diagnostic still proves a real round trip.
CP_PROVIDER_CANDLE_CACHE=true
CP_PROVIDER_CANDLE_CACHE_MAX_ENTRIES=600

CP_PROVIDER_REQUEST_WEIGHT_PER_MINUTE=2400
CP_PROVIDER_MAX_CONCURRENT_REQUESTS=8
CP_PROVIDER_REQUEST_TIMEOUT_SECONDS=15
CP_PROVIDER_MAX_RETRIES=3
CP_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
CP_PROVIDER_CIRCUIT_RESET_SECONDS=60

# -------------------------------------------------------------------- scanner
CP_SCAN_QUOTE_ASSET=USDT
CP_SCAN_MAX_SYMBOLS=120
CP_SCAN_SCAN_INTERVAL_SECONDS=60

# Universe pre-filter, applied before any per-symbol request is spent.
CP_SCAN_MIN_QUOTE_VOLUME_24H=3000000
CP_SCAN_ALWAYS_INCLUDE=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
CP_SCAN_EXCLUDE_PATTERNS=UP,DOWN,BULL,BEAR
CP_SCAN_EXCLUDE_STABLE_BASES=USDC,FDUSD,TUSD,DAI,BUSD,EUR,USDP,USD1

CP_SCAN_PRIMARY_TIMEFRAME=5m
CP_SCAN_TIMEFRAMES=5m,15m,1h,4h
CP_SCAN_CANDLES_PER_TIMEFRAME=300
CP_SCAN_MIN_CANDLES_REQUIRED=60
CP_SCAN_STALE_AFTER_SECONDS=300

# -------------------------------------------------------------------- scoring
# Component weights MUST sum to 100 or the engine refuses to start.
# Changing any of these changes the weights fingerprint recorded with every
# signal, so historical scores are never silently reinterpreted.
CP_SCORE_ENGINE_VERSION=SCORE_ENGINE_V1
CP_SCORE_W_VOLUME=20
CP_SCORE_W_MOMENTUM=15
CP_SCORE_W_STRUCTURE=15
CP_SCORE_W_BREAKOUT=15
CP_SCORE_W_VOLATILITY=10
CP_SCORE_W_ORDERFLOW=10
CP_SCORE_W_MTF=10
CP_SCORE_W_LIQUIDITY=5

CP_SCORE_THRESHOLD_OBSERVE=35
CP_SCORE_THRESHOLD_WATCH=50
CP_SCORE_THRESHOLD_ARMED=65
CP_SCORE_PUMP_MATURITY_LATE=70
CP_SCORE_BREAKOUT_CONFIRM_ATR=0.15
CP_SCORE_ARMED_MAX_DISTANCE_ATR=1.0

# ----------------------------------------------------------------------- risk
CP_RISK_LIQ_EXCELLENT_VOLUME=100000000
CP_RISK_LIQ_GOOD_VOLUME=20000000
CP_RISK_LIQ_ACCEPTABLE_VOLUME=3000000
CP_RISK_LIQ_POOR_VOLUME=500000
CP_RISK_SPREAD_DANGEROUS_BPS=120
CP_RISK_MAX_RISK_PENALTY=45

# --------------------------------------------------------------------- alerts
CP_ALERT_ENABLED=true
CP_ALERT_MIN_SCORE_INFO=50
CP_ALERT_MIN_SCORE_WATCH=60
CP_ALERT_MIN_SCORE_HIGH=72
CP_ALERT_MIN_SCORE_CRITICAL=82
CP_ALERT_COOLDOWN_SECONDS=1800
CP_ALERT_MAX_ALERTS_PER_SCAN=12

# Where alerts are delivered. Leave unset and alerts appear in the dashboard
# only — which means you see them only while looking at it. Set this to receive
# them on your phone. The format is detected from the host: Discord and Slack
# incoming webhooks get readable text, anything else gets a JSON POST carrying
# the full alert.
#
# THIS URL IS A CREDENTIAL. A Discord or Slack webhook URL contains its own
# token: anyone holding the string can post as you. It is never written to a
# log, an error message or an API response — only its host is, redacted.
# Keep it in .env, which git ignores, and never paste it into an issue.
# CP_ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------- database
# SQLite is for local development only. Use PostgreSQL in production.
CP_DB_URL=sqlite:///data/cryptopulse.db
# CP_DB_URL=postgresql+psycopg://user:password@localhost:5432/cryptopulse
CP_DB_ECHO=false

# How long the signal journal is kept. Applied automatically every six hours,
# and on demand via POST /api/maintenance/prune. Score points and scan runs are
# cut sooner (a quarter of this window) because they are high-volume noise.
# A signal that still owes a verdict or a horizon window is NEVER pruned,
# however old it is. Set to 0 to disable pruning entirely.
CP_DB_RETENTION_DAYS=90

# --- Android notifications (Termux) ------------------------------------------
# Needs no account, no token and no URL: it talks to the phone it runs on.
# Requires BOTH the Termux:API app and `pkg install termux-api`. Check with
# `python -m cryptopulse.cli notify`, which sends a real one.
CP_ALERT_ANDROID_NOTIFICATIONS=true
# Lowest level allowed to interrupt you. A notification is a physical
# interruption, so this floor is higher than the webhook's on purpose:
# INFO / WATCH / HIGH / CRITICAL_SETUP
CP_ALERT_ANDROID_MIN_LEVEL=HIGH

# --- Trade Decision Engine ----------------------------------------------------
# What it takes to say 🟢 ACHETER. All seven must clear AT THE SAME TIME — a
# single high score never produces a buy. These are reasoned starting points,
# NOT fitted values, and changing any of them changes the engine's fingerprint
# so past decisions are never reinterpreted under new rules.
CP_TRADE_BUY_MIN_OPPORTUNITY=75
CP_TRADE_BUY_MIN_EXPLOSION=80
CP_TRADE_BUY_MIN_DISCOVERY=70
CP_TRADE_BUY_MIN_CONFIDENCE=85
CP_TRADE_BUY_MIN_SAFETY=80
CP_TRADE_BUY_MAX_PUMP_MATURITY=40
CP_TRADE_BUY_MIN_LIQUIDITY=ACCEPTABLE

# Anti-noise. A decision must repeat this many cycles before the screen changes,
# and cannot change again for this long — except toward the exit, which is never
# delayed.
CP_TRADE_CONFIRMATIONS_REQUIRED=2
CP_TRADE_MIN_SECONDS_BETWEEN_CHANGES=300

# Position watcher: open positions only, faster than the market scan.
# ~9 request-weight per position per cycle against a 6000/min budget.
CP_TRADE_POSITION_WATCH_INTERVAL_SECONDS=15
CP_TRADE_MAX_TRACKED_POSITIONS=20

# --- Robinhood Chain (marché ROBINHOOD, chain id 4663) ------------------------
# RPC public officiel. Rate-limité : suffisant pour le doctor et un polling
# léger. Pour la production, remplacez par un endpoint Alchemy / QuickNode /
# dRPC — l'URL peut contenir votre clé, elle reste dans ce fichier et n'est
# jamais affichée ni journalisée (seul le nom d'hôte apparaît).
CP_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Endpoint de secours facultatif (bascule automatique après deux échecs).
# CP_ROBINHOOD_RPC_FALLBACK_URL=
# Contrat connu facultatif pour le doctor (vérifié sur l'explorer d'abord :
# https://robinhoodchain.blockscout.com). Absent = vérification sautée.
# CP_ROBINHOOD_KNOWN_CONTRACT_ADDRESS=

# --- Sécurité Robinhood (GoPlus) ---------------------------------------------
# Analyse de contrat : honeypot, taxes, droits du propriétaire, verrouillage de
# la liquidité, concentration. Gratuit, limité en débit. Un champ absent signifie
# « contrôle non effectué » et n'est JAMAIS lu comme « sans danger ».
CP_ROBINHOOD_GOPLUS_BASE_URL=https://api.gopluslabs.io
# En dessous de cette part de contrôles disponibles, la sécurité est INCONNUE :
# aucun ACHETER n'est autorisé, sans pour autant déclarer le token dangereux.
CP_ROBINHOOD_SAFETY_MIN_COVERAGE=0.5

# --- Recoupement Robinhood (DexScreener) -------------------------------------
# Deuxième source indépendante sur les mêmes pools. Son intérêt n'est pas
# d'ajouter des données mais de RÉVÉLER LES DÉSACCORDS : deux sources qui
# divergent sur un prix, c'est la seule chose qu'aucune des deux ne peut dire
# seule. Aucune moyenne n'est jamais calculée.
CP_ROBINHOOD_DEXSCREENER_BASE_URL=https://api.dexscreener.com
CP_ROBINHOOD_CROSSCHECK_MAX_PRICE_DRIFT_PCT=5

# --- Décision d'achat Robinhood (ROBINHOOD_TRADE_DECISION_V1) ----------------
# Les six mêmes décisions et les six mêmes couleurs que Binance, à partir de
# preuves entièrement différentes. Les planchers sont volontairement PLUS HAUTS
# que côté Binance : une paire cotée peut être mal vendue, un token frappé ce
# matin peut devenir invendable.
#
# Tous ces seuils entrent dans l'empreinte du moteur : en changer un change
# l'empreinte, donc une décision prise la semaine dernière n'est jamais relue
# sous les règles d'aujourd'hui.
#
# La convergence est exigée : TOUS les planchers doivent être franchis en même
# temps. Un seul score à 100 ne produit jamais 🟢 ACHETER.
CP_ROBINHOOD_BUY_MIN_EARLY=75
CP_ROBINHOOD_BUY_MIN_EXPLOSION=80
CP_ROBINHOOD_BUY_MIN_CONFIDENCE=70
CP_ROBINHOOD_BUY_MIN_SAFETY=85
CP_ROBINHOOD_BUY_MAX_MATURITY=40
# Une profondeur en dollars, pas un rang : sur un DEX la question est de savoir
# si la position pourra être fermée du tout.
CP_ROBINHOOD_BUY_MIN_LIQUIDITY_USD=25000
# En dessous, un pool n'est pas mince : c'est un piège. Veto, pas plancher raté.
CP_ROBINHOOD_DANGER_LIQUIDITY_USD=2000
# HIGH, CRITICAL et UNKNOWN opposent déjà un veto dans ROBINHOOD_SAFETY_V1.
# Ceci décide si MEDIUM est tolérable pour un achat.
CP_ROBINHOOD_BUY_MAX_RUG_RISK=LOW
# 🟡 SURVEILLER, pour ce qui n'est pas un achat mais mérite un second regard.
CP_ROBINHOOD_WATCH_MIN_EARLY=55
CP_ROBINHOOD_WATCH_MIN_CONFIDENCE=40

# --- Surveillance des positions Robinhood ------------------------------------
# Ne regarde que ce que vous détenez. La recherche de nouveaux tokens ne le fera
# jamais : elle ne lit que les pools récents, et un token acheté il y a deux
# jours en est sorti depuis longtemps.
#
# Coût : UNE requête par token détenu pour les pools (l'indexeur n'offre pas de
# lot token → pools), plus une requête par lot de trente pour la sécurité. Dix
# positions coûtent onze requêtes, pas deux. D'où le plafond ci-dessous.
CP_ROBINHOOD_MAX_TRACKED_POSITIONS=20
CP_ROBINHOOD_POSITION_WATCH_INTERVAL_SECONDS=30
