//@version=5
// =============================================================================
// CRYPTO PULSE AI — ARMED setup visualiser
//
// PURPOSE: eyeball, on a real chart, the geometry the Python scanner uses to
// mark an asset ARMED. It is a *visualisation and sanity-check tool*, not a
// reimplementation. Pine cannot scan a whole universe, cannot hold a score
// history across assets, and cannot see an order book — so it should not try.
//
// What this plots:
//   * the resistance level the scanner would treat as the trigger
//   * distance to that level in ATR multiples
//   * the compression → expansion condition
//   * RVOL and volume acceleration
//   * a simplified ARMED / BREAKOUT marker
//
// IMPORTANT DIFFERENCE FROM THE SCANNER: TradingView pivots repaint until
// `right` bars have printed, exactly as the Python `find_swings` accounts for.
// Set `Confirm bars` to the same value the scanner uses (default 3) so the
// levels you see here are the ones the scanner would have had.
// =============================================================================

indicator("CryptoPulse — ARMED Setup", overlay=true, max_lines_count=100, max_labels_count=100)

// ---------------------------------------------------------------- inputs ----
grpS = "Structure"
leftBars   = input.int(3,  "Pivot left bars",    minval=1, group=grpS)
rightBars  = input.int(3,  "Confirm bars (right)", minval=1, group=grpS,
     tooltip="Must match CP structure right-bars. Levels are only valid after this many bars.")
atrLen     = input.int(14, "ATR length",         minval=1, group=grpS)

grpT = "Thresholds (match your .env)"
armedMaxAtr    = input.float(1.0,  "ARMED max distance (ATR)", step=0.1, group=grpT)
breakoutAtr    = input.float(0.15, "Breakout confirm (ATR)",   step=0.05, group=grpT)
rvolMin        = input.float(1.5,  "Minimum RVOL",             step=0.1, group=grpT)
volAccelMin    = input.float(20.0, "Min volume acceleration %", step=5,  group=grpT)
compressionMax = input.float(0.35, "Max BB-width percentile",  step=0.05, group=grpT)

grpV = "Volume"
rvolLen  = input.int(50, "RVOL baseline", minval=5, group=grpV)
fastVol  = input.int(3,  "Fast volume MA", minval=1, group=grpV)
slowVol  = input.int(12, "Slow volume MA", minval=2, group=grpV)

// ------------------------------------------------------------ indicators ----
atrVal = ta.atr(atrLen)

// RVOL: baseline excludes the current bar, matching features/volume.py.
volBaseline = ta.sma(volume, rvolLen)[1]
rvol = volBaseline > 0 ? volume / volBaseline : na

// Volume acceleration: short average vs medium average, in percent.
volAccel = ta.sma(volume, slowVol) > 0
     ? (ta.sma(volume, fastVol) / ta.sma(volume, slowVol) - 1) * 100
     : na

// Bollinger width percentile over the last 120 bars (0 = tightest).
bbBasis = ta.sma(close, 20)
bbDev   = 2 * ta.stdev(close, 20)
bbWidth = bbBasis != 0 ? (2 * bbDev) / bbBasis : na
compression = ta.percentrank(bbWidth, 120) / 100

// ------------------------------------------------------------- structure ----
// ta.pivothigh returns a value `rightBars` bars back — the same confirmation
// lag the Python implementation enforces. Nothing here is known earlier than
// the scanner would have known it.
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

var float resistance = na
var float support    = na
if not na(ph)
    resistance := ph
if not na(pl)
    support := pl

// Distance to the trigger, normalised by ATR so the threshold is scale-free.
distAtr = not na(resistance) and atrVal > 0 ? (resistance - close) / atrVal : na

// ----------------------------------------------------------- conditions -----
volumeOk      = not na(rvol) and rvol >= rvolMin
accelOk       = not na(volAccel) and volAccel >= volAccelMin
compressionOk = not na(compression) and compression <= compressionMax
trendOk       = close > ta.ema(close, 20) and ta.ema(close, 20) > ta.ema(close, 50)

isArmed = not na(distAtr) and distAtr > breakoutAtr and distAtr <= armedMaxAtr
     and volumeOk and trendOk and (accelOk or compressionOk)

isBreakout = not na(resistance) and atrVal > 0
     and close > resistance + breakoutAtr * atrVal
     and close[1] <= resistance[1] + breakoutAtr * atrVal
     and volumeOk

// --------------------------------------------------------------- plotting ---
plot(resistance, "Resistance", color=color.new(color.red, 25), style=plot.style_linebr, linewidth=2)
plot(support,    "Support",    color=color.new(color.green, 25), style=plot.style_linebr, linewidth=2)
plot(ta.ema(close, 20), "EMA20", color=color.new(color.orange, 45))
plot(ta.ema(close, 50), "EMA50", color=color.new(color.blue, 45))
plot(ta.vwap,           "VWAP",  color=color.new(color.purple, 45))

plotshape(isArmed and not isArmed[1], "ARMED", shape.triangleup, location.belowbar,
     color.new(color.orange, 0), size=size.small, text="ARMED")
plotshape(isBreakout, "BREAKOUT", shape.triangleup, location.belowbar,
     color.new(color.green, 0), size=size.small, text="BREAK")

bgcolor(isArmed ? color.new(color.orange, 92) : na, title="ARMED zone")

// ------------------------------------------------------------------ table ---
var table info = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Metric",       text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 0, "Value",        text_color=color.gray, text_size=size.small)
    table.cell(info, 0, 1, "Dist to break", text_size=size.small)
    table.cell(info, 1, 1, na(distAtr) ? "n/a" : str.tostring(distAtr, "#.##") + " ATR",
         text_color=(not na(distAtr) and distAtr <= armedMaxAtr) ? color.orange : color.gray, text_size=size.small)
    table.cell(info, 0, 2, "RVOL",          text_size=size.small)
    table.cell(info, 1, 2, na(rvol) ? "n/a" : str.tostring(rvol, "#.##") + "x",
         text_color=volumeOk ? color.green : color.gray, text_size=size.small)
    table.cell(info, 0, 3, "Vol accel",     text_size=size.small)
    table.cell(info, 1, 3, na(volAccel) ? "n/a" : str.tostring(volAccel, "#") + "%",
         text_color=accelOk ? color.green : color.gray, text_size=size.small)
    table.cell(info, 0, 4, "Compression",   text_size=size.small)
    table.cell(info, 1, 4, na(compression) ? "n/a" : str.tostring(compression * 100, "#") + "th pct",
         text_color=compressionOk ? color.green : color.gray, text_size=size.small)
    table.cell(info, 0, 5, "State",         text_size=size.small)
    table.cell(info, 1, 5, isBreakout ? "BREAKOUT" : isArmed ? "ARMED" : "—",
         text_color=isBreakout ? color.green : isArmed ? color.orange : color.gray, text_size=size.small)

alertcondition(isArmed and not isArmed[1], "CryptoPulse ARMED",
     "{{ticker}} entered ARMED — coiled below resistance with volume")
alertcondition(isBreakout, "CryptoPulse BREAKOUT",
     "{{ticker}} broke resistance on confirming volume")
